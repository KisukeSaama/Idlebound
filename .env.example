# Copy to .env for local development (npm run dev outside Docker).
DATABASE_URL=postgres://idlebound:idlebound@localhost:5432/idlebound
API_PORT=8080
INTERNAL_API_BASE_URL=http://localhost:8080
COOKIE_SECURE=false
# E-mails: without SMTP_URL they are written to the console. To see them rendered,
# start Mailpit (docker compose -f compose.dev.yml up mailpit), then open http://localhost:8025.
# SMTP_URL=smtp://localhost:1025
# Secure cookie: derived from PUBLIC_SITE_URL (https → true) when unset.
# EDGE_PROXY_CIDRS: edge proxy ranges whose cf-connecting-ip is trusted (default: Cloudflare).
