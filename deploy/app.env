# Non-secret defaults and documentation of the file's shape. The CI OVERWRITES this file in
# ${DEPLOY_DIR}/{dev,prod}/app.env with the CI/CD variables: nothing here is read at
# runtime. Never put credentials in it.
POSTGRES_DB=idlebound
POSTGRES_USER=idlebound
SITE_INDEXABLE=false
MAIL_FROM=Idlebound <no-reply@kisukesaama.com>
# SMTP_URL=smtps://user:password@smtp.example.com:465   (CI variable IDLEBOUND_SMTP_URL)
